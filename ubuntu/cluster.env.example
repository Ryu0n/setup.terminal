# 홈랩 k3s 클러스터 인벤토리·설정 예시
#
# 이 파일을 cluster.env 로 복사해 환경에 맞게 고친다. (cluster.env 는 git 에 올리지 않는다)
#   cp cluster.env.example cluster.env
# setup-k3s-cluster.sh 와 send-command.sh 가 cluster.env 를 source 한다.
# 같은 이름의 환경변수가 이미 있으면 그 값이 우선한다.
#   예) WORKER_NODES="berry-1" ./setup-k3s-cluster.sh

# --- 노드 ---
# ssh 가 이해하는 대상이면 무엇이든 된다: 호스트명, IP, user@host, ~/.ssh/config 의 Host 별칭
MASTER_NODE="${MASTER_NODE:-berry-0}"
WORKER_NODES="${WORKER_NODES:-berry-1 berry-2 berry-3}" # 공백으로 구분

# --- SSH ---
SSH_USER="${SSH_USER:-}"                   # 비우면 ssh 기본값 (~/.ssh/config 또는 로컬 사용자명)
SSH_PORT="${SSH_PORT:-}"                   # 비우면 22
SSH_IDENTITY_FILE="${SSH_IDENTITY_FILE:-}" # 비우면 ssh 기본 키 / ssh-agent
SSH_CONNECT_TIMEOUT="${SSH_CONNECT_TIMEOUT:-10}"
# accept-new: 처음 보는 노드의 호스트 키는 자동으로 등록하고, 등록된 키가 바뀌면 거부한다.
SSH_STRICT_HOST_KEY_CHECKING="${SSH_STRICT_HOST_KEY_CHECKING:-accept-new}"

# --- 노드 준비 ---
# 메모리 cgroup 이 꺼진 노드는 커널 인자를 추가한 뒤 재부팅해야 k3s 가 뜬다. (켜져 있는 노드는 건드리지 않는다)
# false 로 두면 커널 인자만 추가하고 멈춘다. 직접 재부팅한 뒤 다시 실행하면 이어서 진행한다.
AUTO_REBOOT="${AUTO_REBOOT:-true}"

# --- 버전 ---
# 빈 값("")으로 두면 실행할 때마다 그 시점의 최신으로 설치·업그레이드된다.
# Cilium 1.20 이 검증한 Kubernetes 는 1.33~1.36 이라 k3s 는 stable 채널(1.37)이 아닌 1.36 라인으로 고정한다.
K3S_VERSION="${K3S_VERSION-v1.36.6+k3s1}"
CILIUM_VERSION="${CILIUM_VERSION-1.20.5}"

# --- 대기(폴링) ---
POLL_INTERVAL="${POLL_INTERVAL:-10}"                  # 초
NODE_REBOOT_TIMEOUT="${NODE_REBOOT_TIMEOUT:-300}"     # 재부팅한 노드가 다시 준비될 때까지 (초)
NODE_REGISTER_TIMEOUT="${NODE_REGISTER_TIMEOUT:-300}" # 모든 노드가 클러스터에 등록될 때까지 (초)
NODE_READY_TIMEOUT="${NODE_READY_TIMEOUT:-900}"       # Cilium 설치 후 모든 노드가 Ready 가 될 때까지 (초)
